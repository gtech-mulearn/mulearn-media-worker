# Local settings for `npm run dev` / `npm run deploy` (dev worker).
# Copy to .env and fill in. .env is git-ignored; never commit it.
# Shared settings (WEBP_QUALITY, CACHE_CONTROL, MEDIA_MODULES) live in wrangler.toml.
# In CI these three values come from GitHub environment secrets/variables instead.

# Same value as the backend SECRET_KEY (mulearnbackend/.env).
# Wrap in single quotes if it contains # or ". Escape $ as \$.
JWT_SECRET='change-me'

# Comma-separated browser origins allowed to call /upload.
ALLOWED_ORIGINS=http://localhost:3000

# Public base URL of the R2 bucket. Same value as backend R2_PUBLIC_BASE_URL.
PUBLIC_BASE_URL=

# Custom domain the worker is deployed to (passed as --domain on deploy, not a secret).
WORKER_DOMAIN=

# Optional. Enable the daily cleanup of images that no record uses.
# BACKEND_URL is the backend address; BACKEND_API_KEY is the backend's BACKEND_API_KEY.
# Leave both empty to skip the cleanup (uploads are not affected).
BACKEND_URL=
BACKEND_API_KEY=
